{
  "expo": {
    "name": "Koin",
    "slug": "koin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "koin",
    "backgroundColor": "#F4F1EA",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Koin needs access to your camera to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Koin needs access to your photo library to pick receipt photos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.manusl.koin"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.manusl.koin"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you pick and review receipts.",
          "cameraPermission": "The app accesses your camera to scan receipts."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "50f065b7-36ad-4451-a577-7f6b7d0b1fc9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/50f065b7-36ad-4451-a577-7f6b7d0b1fc9"
    }
  }
}
